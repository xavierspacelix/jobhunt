// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JobSource {
  GLINTS
  JOBSTREET
}

enum JobScope {
  SHARED
  PRIVATE
}

enum SavedJobOrigin {
  MANUAL
  SEARCH
}

enum ApplicationStatus {
  WISHLIST
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  REJECTED
}

model User {
  id                    String    @id @default(cuid())
  name                  String?
  email                 String    @unique
  emailVerified         DateTime?
  image                 String?
  passwordHash          String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  extensionDownloadedAt DateTime?

  profile         Profile?
  applications    Application[]
  matches         Match[]
  recommendations Recommendation[]
  savedJobs       SavedJob[]
  ownedJobs       Job[]
}

model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  rawText        String?
  fullName       String?
  headline       String?
  location       String?
  email          String?
  phone          String?
  skills         String[]
  summary        String?
  experience     Json?
  education      Json?
  certifications Json?
  links          Json?
  cvKey          String?
  parsedWith     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Job {
  id             String    @id @default(cuid())
  scope          JobScope  @default(SHARED)
  ownerId        String?
  dedupeKey      String    @unique
  title          String
  company        String
  location       String?
  salary         String?
  source         JobSource
  sourceUrl      String
  description    String?
  postedAt       DateTime?
  employmentType String?
  experience     String?
  education      String?
  category       String?
  recruiter      String?
  skills         String[]
  externalJobId  String?
  shareToken     String?
  companyRefId   String?
  companyDetails Json?
  createdAt      DateTime  @default(now())

  owner           User?            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  applications    Application[]
  matches         Match[]
  recommendations Recommendation[]
  savedBy         SavedJob[]

  @@index([scope, ownerId])
  @@index([sourceUrl])
}

model SavedJob {
  id        String         @id @default(cuid())
  userId    String
  jobId     String
  origin    SavedJobOrigin
  createdAt DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model Application {
  id             String            @id @default(cuid())
  userId         String
  jobId          String
  status         ApplicationStatus @default(WISHLIST)
  matchScore     Int?
  matchedSkills  String[]
  missingSkills  String[]
  matchCacheKey  String?
  coverLetter    String?
  notes          String?
  appliedAt      DateTime?
  nextFollowUpAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  emailLogs EmailLog[]

  @@unique([userId, jobId])
}

model Match {
  id            String   @id @default(cuid())
  userId        String
  jobId         String
  score         Int
  matchedSkills String[]
  missingSkills String[]
  source        String?
  cacheKey      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}

model EmailLog {
  id            String   @id @default(cuid())
  applicationId String
  to            String
  subject       String
  body          String
  sentAt        DateTime @default(now())
  providerMsgId String?

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model Recommendation {
  id        String   @id @default(cuid())
  userId    String
  jobId     String
  score     Int?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
}
