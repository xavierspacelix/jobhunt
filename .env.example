# ---- Database (Prisma + Postgres) ----
# Postgres connection string. For local Docker: postgresql://user:pass@localhost:5432/jobhunter?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/jobhunter?schema=public"

# ---- Auth (NextAuth.js v5 / Auth.js) ----
# Email + password (Credentials provider, JWT sessions). No external provider needed.
# Secret used to encrypt session tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public base URL of the deployed app. Required so NextAuth builds correct
# redirect URLs (e.g. post-logout) instead of falling back to http://localhost:3000.
# Set to your production domain, e.g. https://jobhunt.spacelix.qzz.io
AUTH_URL=""
# Optional future providers (OD-005): uncomment when enabled.
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# ---- Provider-agnostic LLM (CV, matching, keywords, cover letter) ----
# OpenAI-compatible endpoint, e.g. DeepSeek, Groq, OpenRouter, or Ollama.
# e.g. DeepSeek, Groq, OpenRouter, Ollama. Leave blank to use heuristic fallback.
LLM_BASE_URL=""
LLM_API_KEY=""
LLM_MODEL=""

# ---- Object Storage (Feature 02) ----
# S3-compatible MinIO for CV PDF blobs. Leave blank to use local-disk fallback.
# NOTE: MinIO API port 9000 is plaintext HTTP by default — set MINIO_USE_SSL=false
# unless your MinIO is behind TLS. A TLS-to-plaintext mismatch throws
# "EPROTO wrong version number" on CV upload. You may also pass a full URL in
# MINIO_ENDPOINT (e.g. http://minio:9000) and the scheme drives TLS.
MINIO_ENDPOINT=""
MINIO_PORT="9000"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET="jobhunter"
MINIO_USE_SSL="false"

# ---- Process-local rate limits (optional, per 60 seconds by default) ----
RATE_LIMIT_WINDOW_MS="60000"
RATE_LIMIT_MATCH_MAX="10"
RATE_LIMIT_COVER_LETTER_MAX="10"
RATE_LIMIT_CV_UPLOAD_MAX="5"
RATE_LIMIT_JOB_SEARCH_MAX="5"
RATE_LIMIT_JOB_FETCH_MAX="5"
RATE_LIMIT_RECOMMEND_KEYWORDS_MAX="10"
RATE_LIMIT_RECOMMENDATION_SAVE_MAX="10"
RATE_LIMIT_REGISTER_MAX="5"
RATE_LIMIT_LOGIN_MAX="10"

# Email/Resend is deferred under OD-003 and has no runtime variables yet.
