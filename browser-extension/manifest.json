{
  "manifest_version": 3,
  "name": "Job Hunter",
  "description": "Ambil detail lowongan Glints atau Jobstreet, tinjau, lalu simpan langsung ke Job Hunter.",
  "version": "2.1.0",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage", "identity", "tabs"],
  "background": { "service_worker": "service-worker.js" },
  "externally_connectable": {
    "matches": ["https://jobhunt.spacelix.qzz.io/*"]
  },
  "host_permissions": [
    "https://jobhunt.spacelix.qzz.io/*",
    "https://glints.com/*",
    "https://*.glints.com/*",
    "https://id.jobstreet.com/*",
    "https://*.jobstreet.co.id/*",
    "https://jobstreet.com/*",
    "https://*.jobstreet.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Job Hunter",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_popup": "popup.html"
  }
}
